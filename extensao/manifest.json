{
  "manifest_version": 3,
  "name": "Convergio — downloads acelerados",
  "short_name": "Convergio",
  "version": "1.2.0",
  "description": "Envia os downloads do navegador para o Convergio, o acelerador de downloads.",
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "notifications", "alarms", "webRequest", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Convergio",
    "default_popup": "popup.html",
    "default_icon": { "16": "icones/icone16.png", "32": "icones/icone32.png", "48": "icones/icone48.png" }
  },
  "icons": { "16": "icones/icone16.png", "32": "icones/icone32.png", "48": "icones/icone48.png", "128": "icones/icone128.png" }
}
